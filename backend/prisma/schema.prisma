// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// Utilizado exclusivamente para autenticação JWT na área de configuração.
// Senhas são armazenadas como hash bcrypt — NUNCA em texto puro.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

enum UserRole {
  ADMIN
  VIEWER
}

// ─────────────────────────────────────────────────────────────────────────────
// Service
// Representa cada serviço descoberto via GET /services da API de métricas.
// O campo `status` é atualizado a cada ciclo de coleta pelo CollectorService.
// ─────────────────────────────────────────────────────────────────────────────
model Service {
  id         String        @id @default(uuid()) @db.Uuid
  externalId String        @unique @map("external_id") @db.VarChar(255)
  name       String        @db.VarChar(255)
  status     ServiceStatus @default(ACTIVE)

  // Localização geográfica (fornecida pela API de métricas)
  // regionCode (ex: "br-sudeste") é a chave de consulta na API de carbono
  regionCode String?  @map("region_code") @db.VarChar(100)
  country    String?  @db.VarChar(100)
  region     String?  @db.VarChar(100)
  city       String?  @db.VarChar(100)
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relação 1:N com snapshots
  snapshots MetricSnapshot[]

  // Índices
  @@index([status])
  @@index([externalId])
  @@map("services")
}

enum ServiceStatus {
  ACTIVE       // Serviço ativo e exportando métricas normalmente
  UNAVAILABLE  // Serviço não responde ao endpoint de métricas (RF05)
  STALE        // Serviço aparece na lista mas parou de exportar métricas (RF06)
}

// ─────────────────────────────────────────────────────────────────────────────
// MetricSnapshot
// Tabela APPEND-ONLY — nunca atualizada, apenas inserida.
// Cada linha representa uma coleta pontual de métricas de um serviço.
// Os campos energy_kwh e co2e_grams são calculados pelo EnergyCalculatorService
// antes da inserção — NUNCA no controller.
// ─────────────────────────────────────────────────────────────────────────────
model MetricSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz(6)

  // Métricas brutas recebidas da API externa (GET /metrics/{id})
  cpuPercent                Decimal? @map("cpu_percent") @db.Decimal(6, 3)  // 0–100
  memoryGb                  Decimal? @map("memory_gb") @db.Decimal(12, 4)
  diskGb                    Decimal? @map("disk_gb") @db.Decimal(12, 4)
  networkGb                 Decimal? @map("network_gb") @db.Decimal(12, 4)
  collectionIntervalSeconds Int?     @map("collection_interval_seconds")

  // Valores calculados pelo EnergyCalculatorService
  energyKwh   Decimal? @map("energy_kwh") @db.Decimal(18, 9)  // Alta precisão
  co2eGrams   Decimal? @map("co2e_grams") @db.Decimal(18, 6)

  // Intensidade de carbono usada no cálculo (snapshot do valor no momento)
  carbonIntensityGco2 Decimal? @map("carbon_intensity_gco2") @db.Decimal(10, 4)

  // Payload bruto da API (auditabilidade e depuração)
  rawPayload Json? @map("raw_payload") @db.JsonB

  // Flags de estado da coleta
  isStale      Boolean @default(false) @map("is_stale")    // RF06
  errorMessage String? @map("error_message") @db.Text      // RF05

  // Relação N:1 com Service
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Índices críticos para performance em consultas temporais e no dashboard
  @@index([serviceId, collectedAt(sort: Desc)], name: "idx_snapshots_service_time")
  @@index([collectedAt(sort: Desc)],            name: "idx_snapshots_time")
  @@index([isStale],                            name: "idx_snapshots_stale")
  @@map("metric_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// CarbonIntensity
// Cache das leituras da API de intensidade de carbono por região.
// Também APPEND-ONLY — consultas sempre buscam a leitura mais recente (last).
// Permite operação degradada (fallback) quando a API de carbono estiver offline.
// ─────────────────────────────────────────────────────────────────────────────
model CarbonIntensity {
  id                    String   @id @default(uuid()) @db.Uuid
  regionCode            String   @map("region_code") @db.VarChar(100)
  country               String?  @db.VarChar(100)
  intensityGco2         Decimal  @map("intensity_gco2") @db.Decimal(10, 4) // gCO₂e/kWh
  renewableSharePercent Decimal? @map("renewable_share_percent") @db.Decimal(5, 2)
  recordedAt            DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  // Índice composto para o padrão de consulta: "última leitura por região"
  @@index([regionCode, recordedAt(sort: Desc)], name: "idx_carbon_region_time")
  @@map("carbon_intensities")
}
