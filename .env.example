# ──────────────────────────────────────────────
# GreenER — Variáveis de Ambiente (Template)
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env no repositório.
# ──────────────────────────────────────────────

# ── Banco de Dados ──────────────────────────
POSTGRES_USER=greener
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=greener_db
DATABASE_URL=postgresql://greener:CHANGE_ME_STRONG_PASSWORD@postgres:5432/greener_db

# ── APIs Externas ───────────────────────────
METRICS_API_URL=https://metrics.unilaunch.org
CARBON_API_URL=https://carbon.unilaunch.org

# ── Autenticação JWT ────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_STRONG_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=8h

# ── Admin Inicial ────────────────────────────
# Gere o hash bcrypt com: node -e "const b=require('bcrypt');b.hash('sua_senha',12).then(console.log)"
# A senha em texto puro NUNCA deve aparecer aqui.
ADMIN_INITIAL_PASSWORD_HASH=$2b$12$CHANGE_ME_BCRYPT_HASH

# ── Coletor em Background ───────────────────
COLLECTOR_INTERVAL_SECONDS=30
COLLECTOR_MAX_CONCURRENT=5
